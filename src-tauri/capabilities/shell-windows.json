{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-windows",
  "description": "Shell the app runs commands in on Windows (see src/providers/shell.ts and src-tauri/src/shell.rs)",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell.exe",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell.exe",
          "args": true
        }
      ]
    }
  ]
}
