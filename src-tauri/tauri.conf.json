{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M Code",
  "version": "0.1.0",
  "identifier": "com.maksimkulakov.mcode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "M Code",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../sidecar/cursor-agent.mjs": "sidecar/cursor-agent.mjs",
      "../sidecar/package.json": "sidecar/package.json",
      "../sidecar/node_modules/": "sidecar/node_modules/",
      "../sidecar/codex-limits.mjs": "sidecar/codex-limits.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
