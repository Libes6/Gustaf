{
  "name": "mcode-monorepo",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "preview": "npm run preview -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "check": "npm run check -w apps/desktop && npm run check -w packages/protocol",
    "test": "npm test -w apps/desktop",
    "test:ui": "npm run test:ui -w apps/desktop",
    "test:e2e": "npm run test:e2e -w apps/desktop"
  }
}
