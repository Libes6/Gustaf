{
  "name": "mcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "node scripts/check-i18n.mjs && tsc --noEmit && npm test && cargo test --manifest-path src-tauri/Cargo.toml",
    "predev": "node scripts/build-canvas.mjs",
    "prebuild": "node scripts/build-canvas.mjs",
    "test:canvas": "node --test tests/canvas.test.mjs",
    "test:chat": "node --test tests/chatSessions.test.mjs",
    "test:usage": "node --test tests/usage.test.mjs",
    "test:cli": "node --test tests/cliArgs.test.mjs",
    "test:csp": "node --test tests/csp.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
