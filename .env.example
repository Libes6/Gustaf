# Gustaf builds ship without T3 Connect, T3's Clerk sign-in, relay, or trace exporters.
# `scripts/lib/public-config.ts` drops T3CODE_CLERK_*, T3CODE_RELAY_URL, and the OTLP trace
# variables from every build, so setting them here has no effect.
#
# Gustaf's own services need no build-time variables. Override their addresses at runtime:
#   GUSTAF_API_URL                 (desktop, `gustaf relay`) Gustaf Cloud, default https://api.libes6.ru
#   EXPO_PUBLIC_GUSTAF_API_URL     (mobile) Gustaf Cloud
#
# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# Signed macOS builds: the passkey entitlement needs the team, a provisioning profile, and the
# domains it covers. This one setting still reaches the build.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/profile.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.com
