{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "plugins": [
      {
        "name": "@effect/language-service",
        // A plain React app without Effect: the Effect-specific rules do not apply.
        "diagnosticSeverity": {
          "extendsNativeError": "off",
          "globalDate": "off",
          "globalFetch": "off"
        }
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
