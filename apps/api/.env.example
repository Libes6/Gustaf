HOST=127.0.0.1
PORT=3100
DATABASE_URL=postgresql://gustaf:gustaf_local@127.0.0.1:55432/gustaf_cloud
# Express trust proxy: hop count, true/false, or address list. Default 1 (Coolify's Traefik).
TRUST_PROXY=1
# Apply pending migrations before the container's server starts (dist/start.js). Set 0 to skip.
RUN_MIGRATIONS=1
# Accounts (Better Auth + GitHub OAuth). Set AUTH_ENABLED=0 to run health-only without these.
AUTH_ENABLED=1
# At least 32 random characters, e.g. `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Public origin of this API. The GitHub OAuth app callback is PUBLIC_BASE_URL/v1/auth/callback/github.
PUBLIC_BASE_URL=http://localhost:3100
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated extra origins and app deep-link schemes allowed as sign-in callbacks,
# e.g. https://admin.example.com,gustaf://
AUTH_TRUSTED_ORIGINS=
# Comma-separated GitHub logins (case-insensitive) that become admins when they sign in.
# Removing a login does not demote anyone; use PATCH /v1/admin/users/:id/role. Empty: nobody.
ADMIN_GITHUB_LOGINS=
# Exact origin of the admin app, e.g. https://admin.example.com. Enables credentialed CORS for it
# and is the only Origin accepted for admin mutations. Outside NODE_ENV=production,
# http://localhost:5174 is allowed as well. Empty: no CORS.
ADMIN_ORIGIN=
# Set at image build (Dockerfile build args) and shown in the admin overview.
# GUSTAF_VERSION=dev
# GUSTAF_COMMIT=unknown

# Monthly relay traffic per user, in GB; over it new relay channels are refused.
# RELAY_MONTHLY_GB=100
