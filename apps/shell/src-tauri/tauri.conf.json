{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gustaf",
  "version": "0.7.1",
  "identifier": "io.github.libes6.gustaf",
  "build": {
    "devUrl": "http://127.0.0.1:9"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Libes6/Gustaf/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
