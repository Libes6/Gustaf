{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Commands and plugins the Gustaf page may use. It is granted to the page of the server the shell started, at its exact origin, by ipc_scope.rs at startup; this file names no origin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "notification:allow-notify",
    "allow-dropped-paths",
    "allow-drag-window",
    "allow-read-connection-catalog",
    "allow-write-connection-catalog",
    "allow-reveal-window",
    "allow-window-fullscreen-state",
    "allow-set-window-theme",
    "allow-read-client-settings",
    "allow-write-client-settings",
    "allow-local-environment-bootstraps",
    "allow-local-environment-bearer-token",
    "allow-local-environment-enabled",
    "allow-set-local-environment-enabled",
    "allow-server-exposure-state",
    "allow-set-server-exposure-mode",
    "allow-set-tailscale-serve-enabled",
    "allow-advertised-endpoints",
    "allow-client-platform",
    "allow-app-branding",
    "allow-update-state",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-account-state",
    "allow-account-sign-in",
    "allow-account-cancel-sign-in",
    "allow-account-sign-out",
    "allow-account-devices",
    "allow-account-register-device",
    "allow-account-revoke-device"
  ]
}
